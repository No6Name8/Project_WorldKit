# Copy to `.env` (gitignored) and fill in. Variable names only - never commit real values.

# Meta Model API key (https://dev.meta.ai): Muse Spark (object detection/analysis, natural-language edits) and SAM 3.1 (segmentation).
# Base URL (https://api.meta.ai/v1) is fixed in worldkit/meta_api.py.
MODEL_API_KEY=

# Optional: Hugging Face token. Used by the hosted TRELLIS / Hunyuan3D fallback backends (--mesh-backend trellis|hosted).
# SAM 3D Objects' gated checkpoints use a *Modal secret* instead: `modal secret create huggingface HF_TOKEN=...` (see pipeline/README.md).
HF_TOKEN=

# Optional: only used by a standalone connectivity check, not by the pipeline.
BASETEN_API_KEY=

# Laptop worker login (python -m worldkit.worker): the same Supabase account you upload videos with
WORKER_EMAIL=
WORKER_PASSWORD=
