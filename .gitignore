*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin
*.npy
weights/
checkpoints/

# --- Pipeline run outputs / local caches (never committed; see CLAUDE.md) ---
pipeline/runs/
pipeline/.cache/

# --- Large media and generated 3D output ---
*.mp4
*.mov
*.avi
*.mkv
*.glb
*.gltf
*.stl
*.ply
*.obj
*.fbx
# One small (~170KB) bundled demo sample is tracked on purpose so the
# viewer has something to load out of the box -- real reconstruction output,
# not a placeholder.
!viewer/assets/sample_mug.glb

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# --- Bundled demo assets + vendored libraries (tracked on purpose: the viewer must work offline with no GPU/API key) ---
!viewer/assets/demo/
!viewer/assets/demo/**
!viewer/vendor/**
!pipeline/samples/mug_on_table.mp4
