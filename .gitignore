# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Node / Next.js (/app) ---
node_modules/
.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.turbo/
coverage/
